# Copy to .env (never commit .env). Free keys:
#   VirusTotal: https://www.virustotal.com/gui/my-apikey
#   AbuseIPDB:  https://www.abuseipdb.com/account/api
#   urlscan.io (optional, raises rate limits): https://urlscan.io/user/profile/
#   AlienVault OTX (optional, raises rate limits): https://otx.alienvault.com/settings
#   MxToolbox (blacklist checks need a paid plan): https://mxtoolbox.com/user/api
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=
MXTOOLBOX_API_KEY=

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
